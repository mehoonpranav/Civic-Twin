# ── Client (baked in at build time — must use VITE_ prefix) ──────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key_here

# ── Server (Vercel runtime secrets — never prefix with VITE_) ────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key_here
# New dashboard calls this SUPABASE_SECRET_KEY. Either name works.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── AI (pick ONE provider) ───────────────────────────────────────────
# CivicTwin default: VyceAI (OpenAI-compatible)
AI_PROVIDER=vyce
AI_API_KEY=sk-...
AI_MODEL=auto
AI_BASE_URL=https://vyceai.com/v1

# Other options:
#   AI_PROVIDER=openai       AI_API_KEY=sk-...      AI_MODEL=gpt-4o-mini
#   AI_PROVIDER=openrouter   AI_API_KEY=sk-or-...   AI_MODEL=openai/gpt-4o-mini
#   AI_PROVIDER=anthropic    AI_API_KEY=sk-ant-...  AI_MODEL=claude-sonnet-4-5
# Legacy alias: VYCEAI_API_KEY also works

# ── Cloudflare Images (report photos) ────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_IMAGES_API_TOKEN=your_images_api_token
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your_account_hash
# Public URLs will be:
#   https://imagedelivery.net/<ACCOUNT_HASH>/<IMAGE_ID>/public
